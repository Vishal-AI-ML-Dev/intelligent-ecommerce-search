# Copy to .env for local use. Never commit .env. Placeholders only.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_search
POSTGRES_USER=ecommerce_search
# Required: choose a non-empty local-only password (Compose refuses to start without one).
POSTGRES_PASSWORD=

# Conservative local-development defaults; not benchmarked and not production SLOs.
DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000

# Lexical search (Milestone 3). Forwarded to the api container by Compose with these defaults.
SEARCH_LEXICAL_K=50
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_QUERY_LENGTH=200

# Dense search (Milestone 4). SEARCH_DENSE_K is forwarded to the api container by Compose.
SEARCH_DENSE_K=50
# The embedding model is pinned in code (ADR-006); only reviewed registry entries are accepted.
# Host default for model snapshots: the git-ignored models/ directory at the repository root.
# The api container always uses its read-only mount (/models). Uncomment only to override.
# EMBEDDING_MODELS_DIR=
EMBEDDING_BATCH_SIZE=32

# Hybrid search (Milestone 5). Forwarded to the api container by Compose with these defaults.
# SEARCH_CANDIDATE_K is the fused list length and the maximum hybrid top_k.
SEARCH_CANDIDATE_K=50
# Reciprocal Rank Fusion constant: provisional until Golden Dataset evaluation in M10.
SEARCH_RRF_K=100

# Cross-encoder reranking (Milestone 8, V3). Forwarded to the api container by Compose with these
# defaults. The model is a provisional compatibility pin (ADR-007), not a quality selection; only
# the reviewed registry entry at its pinned revision is accepted. Its snapshot must already be
# present locally (`python -m ecommerce_search.search model-fetch --kind reranker`); it is never
# downloaded at request time. RERANKER_ENABLED=false makes /search/reranked return the V2 order.
RERANKER_ENABLED=true
RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_MODEL_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RERANKER_BATCH_SIZE=16
# Fused candidates reranked per query; must not exceed SEARCH_CANDIDATE_K.
SEARCH_RERANK_DEPTH=20

# Optional Jev decision provider (Milestone 11, ADR-005). Off by default and not used by any
# endpoint; no key is needed while JEV_ENABLED=false. Never commit a real key: put it only in your
# local, git-ignored .env. TYPESAFE_API_KEY is the official TypeSafe variable name. The model must
# be a versioned id (not jev-latest/jev-preview). Timeout values are provisional and are not a
# wall-clock deadline (docs/jev-provider-m11.md). Not forwarded to any Compose service.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_BASE_URL=https://api.typesafe.ai
JEV_ATTEMPT_TIMEOUT_SECONDS=1.25
JEV_MAX_RETRIES=1
JEV_RETRY_BUDGET_SECONDS=3.0
# Caller wait bound for one Jev call (plus scheduling tolerance); must cover the two above.
JEV_DEADLINE_SECONDS=3.0
JEV_MAX_IN_FLIGHT=8
