# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Environment and secrets
.env
.env.*
!.env.example

# IDE and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build and coverage
build/
dist/
*.egg-info/
.coverage
htmlcov/

# Local data and model artifacts
*.log
data/raw/*
data/processed/*
/models/

# Golden Dataset freeze staging left behind by an interrupted freeze (M9). Never committed;
# the runners refuse to start until it is inspected and removed by hand.
.freeze-staging-*/

# Keep directory placeholders if added intentionally
!.gitkeep

# Frontend (M25A): dependencies and Playwright output; the build output is covered by dist/ above
frontend/node_modules/
frontend/test-results/
frontend/playwright-report/

# Terraform (M26A): state, plans, provider caches and local inputs never enter Git.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
infra/**/backend.hcl
crash.log
